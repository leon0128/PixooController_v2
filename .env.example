# Copy to .env and adjust as needed. Consumed by docker-compose.yml.

POSTGRES_USER=pixoo
POSTGRES_PASSWORD=pixoo
POSTGRES_DB=pixoo

# The address you open the app at, as the browser sees it. Only used by
# docker-compose.prod.yml, where it is baked into the frontend at build time —
# change it and the web image has to be rebuilt. Set it to the Pi's IP or hostname.
PIXOO_HOST=localhost

# Host-side ports. Change these if something else already uses them.
WEB_PORT=3000
API_PORT=3001
DB_PORT=5432

# Timezone the weekly schedule is interpreted in.
TZ=Asia/Tokyo

# Pause between consecutive requests to the Pixoo64, in milliseconds. The device
# needs a moment to finish applying one before the next arrives.
PIXOO_REQUEST_INTERVAL_MS=500

# How long to wait for the Pixoo64 to answer, in milliseconds. It works through a
# request before replying, and a 60-frame background takes it about six seconds.
PIXOO_REQUEST_TIMEOUT_MS=30000
